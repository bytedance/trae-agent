agents:
    trae_agent:
        enable_lakeview: true
        model: trae_agent_model
        max_steps: 200
        tools:
            - bash
            - str_replace_based_edit_tool
            - sequentialthinking
            - task_done
allow_mcp_servers:
    - playwright
    - gbr
mcp_servers:
    playwright:
        command: npx
        args:
            - "@playwright/mcp@0.0.27"
    # Build Remote Agent (gbr/1). Requires `gbr-agent run`. Clone
    # https://github.com/LinespottingOrg/GrokBuildRemote-Agents and npm install mcp/gbr-mcp.
    # Phone is spectator. Never put mailbox keys here.
    gbr:
        command: node
        args:
            - GrokBuildRemote-Agents/mcp/gbr-mcp/bin/gbr-mcp.js
lakeview:
    model: lakeview_model

model_providers:
    anthropic:
        api_key: your_anthropic_api_key
        provider: anthropic

models:
    trae_agent_model:
        model_provider: anthropic
        model: claude-4-sonnet
        max_tokens: 4096
        temperature: 0.5
        top_p: 1
        top_k: 0
        max_retries: 10
        parallel_tool_calls: true
    lakeview_model:
        model_provider: anthropic
        model: claude-3.5-sonnet
        max_tokens: 4096
        temperature: 0.5
        top_p: 1
        top_k: 0
        max_retries: 10
        parallel_tool_calls: true
