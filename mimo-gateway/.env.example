# MiMo 远端 API 配置(必填,本机从环境变量读取)
MIMO_API_KEY=sk-mimo-xxxxxxxxxxxxxxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# 本地小模型路径(默认就是已下载的 Qwen2.5-0.5B Q4_K_M)
LOCAL_MODEL_PATH=/workspace/mimo-gateway/.cache/models/Qwen--Qwen2.5-0.5B-Instruct-GGUF/snapshots/master/qwen2.5-0.5b-instruct-q4_k_m.gguf
LOCAL_MODEL_CTX=2048
LOCAL_MODEL_THREADS=2

# 脱敏模式:off | regex | hybrid
#  - off    : 关闭,纯透传(不推荐,数据会原样发到远端)
#  - regex  : 仅正则,稳定可靠,覆盖 EMAIL/PHONE/IDCARD/CARD/IP/JWT/AWSKEY/PRIVKEY/SECRET 等
#  - hybrid : 正则 + 本地小模型(⚠️ 当前 0.5B 模型不可靠,需要 ≥1.5B)
SANITIZE_MODE=regex

# 网关监听
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
